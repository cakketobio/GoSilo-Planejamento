categorias = {
    'Viabilidade simples', ...
    'Viabilidade dificil', ...
    'Viabilidade media'
};
valores = [20, 40, 40];
rotulos = {'20% (1 de 5)', '40% (2 de 5)', '40% (2 de 5)'};

figure('Color', 'white');
hold on;

for i = 1:3
    if i == 1
        cor = [0.6, 0.6, 0.6];   
    else
        cor = [0.05, 0.45, 0.95]; 
    end
    patch([0, valores(i), valores(i), 0], [i-0.2, i-0.2, i+0.2, i+0.2], cor, 'EdgeColor', 'none');
    text(valores(i) + 2, i, rotulos{i}, 'FontSize', 10, 'VerticalAlignment', 'middle');
end

set(gca, 'YTick', 1:3, 'YTickLabel', categorias, 'FontSize', 10);
ylim([0.4, 3.6]);
xlim([0, 60]);
xlabel('Percentual (%)', 'FontSize', 10);
title({'80% dos desejos dos usuarios tem viabilidade media ou dificil', ...
       'Percentual dos 5 desejos extraidos das entrevistas, por nivel de viabilidade tecnica'}, ...
       'FontSize', 11, 'FontWeight', 'bold');
box off;
hold off;
